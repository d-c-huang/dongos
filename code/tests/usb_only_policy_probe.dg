module usb_only_policy_probe;
import lib.hardware_profile as hardware_profile;
import lib.device_abi as abi;
import user.device_manager as ledger;
import drivers.device_policy as policy;
import usb_only_claim_guard as guard;

export("usb_policy_mode") fn mode()u64 {if hardware_profile.USB_ONLY{return 1;}return 0;}
export("usb_policy_audit_bytes") fn audit_bytes()usize{return hardware_profile.FAT_AUDIT_BYTES;}
export("usb_policy_rank") fn rank(d:*const abi.Device,role:u64)u64 {unsafe{return policy.rank(d,role);}}
export("usb_policy_init") fn initialize(t:*ledger.Table)u64 {unsafe {match ledger.initialize(t){ok=>{return 0;},err(e)=>{return e;},}}}
export("usb_policy_register") fn register(t:*ledger.Table,d:*const abi.Device,out:*abi.Device)u64 {unsafe {match ledger.register(t,d,out){ok=>{return 0;},err(e)=>{return e;},}}}
export("usb_policy_bind") fn bind(t:*ledger.Table,token:u64,d:*const abi.Device,role:u64,out:*abi.Binding)u64 {unsafe {match ledger.bind(t,token,d,role,out){ok=>{return 0;},err(e)=>{return e;},}}}
export("usb_policy_binding") fn binding(t:*const ledger.Table,role:u64,out:*abi.Binding)u64 {unsafe {match ledger.binding(t,role,out){ok=>{return 0;},err(e)=>{return e;},}}}
export("usb_policy_claim") fn claim(id:usize,ecam:u64)u64 {unsafe {match guard.claim(id,ecam){ok=>{return 0;},err(e)=>{return e;},}}}
export("usb_policy_admit") fn admit(role:u64,ecam:u64)u64 {unsafe {match guard.admit(role,ecam){ok=>{return 0;},err(e)=>{return e;},}}}
export("usb_policy_sizes") fn sizes(index:u64)usize {if index==0{return sizeof(ledger.Table);}if index==1{return sizeof(abi.Device);}return sizeof(abi.Binding);}
