// Bounded view of one FAT32 volume on the already selected USB medium.
// Pure first-sector parsing; the filesystem independently audits the VBR/FAT.
module drivers.usb_partition;
pub error Invalid=0x081f_0001;
pub error Unsupported=0x081f_0002;
pub error Bounds=0x081f_0003;
pub struct View {pub base:u64,pub capacity:u64,pub disk_capacity:u64}
pub const EMPTY:View=View {base:0,capacity:0,disk_capacity:0};
unsafe fn u16(p:*const u8,n:usize)u64 {unsafe{return *(p+n) as u64|((*(p+n+1) as u64)<<8);}}
unsafe fn u32(p:*const u8,n:usize)u64 {unsafe{return u16(p,n)|(u16(p,n+2)<<16);}}
unsafe fn is_bpb(p:*const u8)bool {unsafe {
    return u16(p,11)==512&&*(p+16)==2&&u16(p,17)==0&&u16(p,19)==0&&u16(p,22)==0;
}}
unsafe fn superfloppy(p:*const u8,disk:u64)!u64 {unsafe {
    let jump=*(p+0)==0xe9||(*(p+0)==0xeb&&*(p+2)==0x90);
    let spc=*(p+13) as u64;let reserved=u16(p,14);let fats=u32(p,36);let total=u32(p,32);
    let root=u32(p,44);let fsinfo=u16(p,48);let backup=u16(p,50);
    if !jump||spc==0||spc>128||(spc&(spc-1))!=0||reserved<8||fats==0
        ||*(p+21)!=0xf8||u16(p,40)!=0||u16(p,42)!=0 {return error.Invalid;}
    if u32(p,28)!=0||u32(p,82)!=0x3354_4146||u32(p,86)!=0x2020_2032 {return error.Invalid;}
    if total<65536||total>disk {return error.Bounds;}
    let data=reserved+2*fats;
    if data>=total {return error.Invalid;}
    let clusters=(total-data)/spc;
    if clusters<65525||clusters>=0x0fff_fff5||clusters+2>fats*128
        ||root<2||root>=clusters+2||fsinfo==0||fsinfo>=reserved
        ||backup==0||backup>=reserved||backup+fsinfo>=reserved {return error.Invalid;}
    return total;
}}
// Failure never publishes a partial view. Exactly one nonempty MBR entry is
// supported; empty entries must be entirely zero, including their CHS fields.
pub unsafe fn inspect(sector:[]const u8,disk_sectors:u64,out:*View)!void {unsafe {
    if sector.ptr==null||sector.len<512||out==null {return error.Invalid;}
    if disk_sectors<65536||disk_sectors>0xffff_ffff {return error.Bounds;}
    let p=sector.ptr;if u16(p,510)!=0xaa55 {return error.Invalid;}
    var selected:usize=0;var found:usize=0;var index:usize=0;var partition_shape:bool=false;
    while index<4 {
        let at=446+index*16;var any:bool=false;var byte:usize=0;
        while byte<16 {if *(p+at+byte)!=0 {any=true;}byte+=1;}
        if any {
            selected=at;found+=1;
            let first=u32(p,at+8);let count=u32(p,at+12);
            if *(p+at+4)!=0&&first!=0&&first<disk_sectors&&count!=0&&count<=disk_sectors-first {partition_shape=true;}
        }index+=1;
    }
    if is_bpb(p) {
        if partition_shape {return error.Invalid;}
        let capacity=try superfloppy(p,disk_sectors);
        *out=View {base:0,capacity:capacity,disk_capacity:disk_sectors};return;
    }
    if u16(p,444)!=0 {return error.Invalid;}
    if found!=1 {return error.Invalid;}
    let boot=*(p+selected);let kind=*(p+selected+4);
    if boot!=0&&boot!=0x80 {return error.Invalid;}
    if kind!=0x0b&&kind!=0x0c&&kind!=0xef {return error.Unsupported;}
    let base=u32(p,selected+8);let capacity=u32(p,selected+12);
    if base==0||base>=disk_sectors||capacity<65536||capacity>disk_sectors-base {return error.Bounds;}
    *out=View {base:base,capacity:capacity,disk_capacity:disk_sectors};
}return;}
// Validate the view as well as each request, even if a caller forged a View.
// Relative-to-physical addition is safe only after both subtractive bounds.
pub unsafe fn translate(view:*const View,lba:u64,count:u64,out:*u64)!void {unsafe {
    if view==null||out==null {return error.Invalid;}let v=*view;
    if v.disk_capacity==0||v.disk_capacity>0xffff_ffff||v.capacity==0
        ||v.base>=v.disk_capacity||v.capacity>v.disk_capacity-v.base {return error.Bounds;}
    if count==0||lba>=v.capacity||count>v.capacity-lba {return error.Bounds;}
    *out=v.base+lba;
}return;}
