// Explicit diagnostic profile only. BSP owns STATE until compositor handoff.
module boot.startup_console;
import sched.user_boot as ub;
import sched.user_domain as ud;
import sched.user_entry_plan as ep;
import sched.user_bridge as bridge;
import user.abi as abi;
pub const INVALID:u64=0x0b07_0001;
pub struct Report{pub version:u64,pub done:u64,pub error_code:u64,pub kind:u64,
 pub returns:u64,pub captures:u64,pub logs:u64,pub slot:u64,pub operation:u64,pub event:u64,
 pub syscalls:u64,pub entries:u64,pub bridge_stage:u64,pub rip:u64,pub stopped:u64,pub accepted:u64,
 pub text:[8][41]u8,pub first:[8][41]u8,pub fault:u64}
const EMPTY:Report=Report{version:0,done:0,error_code:0,kind:0,returns:0,captures:0,logs:0,slot:16,
 operation:0,event:0,syscalls:0,entries:0,bridge_stage:0,rip:0,stopped:0,accepted:0,text:[[0;41];8],first:[[0;41];8],fault:0};
var STATE:Report=EMPTY;
var FIRST_KIND:u64=0;
var FIRST_CLOSED:bool=false;
var TERMINAL_KIND:u64=0;
var TERMINAL_CLOSED:bool=false;
pub export("dong_startup_console_pointer") fn pointer()*const Report{unsafe{return &STATE;}}
// Eight last nonempty wrapped rows. A clipped ring prefix is discarded through
// its first LF. CR is ignored; other controls become '?'; every row is NUL-ended.
unsafe fn lines(ring:*const u8,count:u64,available:u64)void{unsafe{
 STATE.text=[[0;41];8];var first:u64=0;if count>4096{first=count-4096;}
 if available>4096&&first<available-4096{first=available-4096;}
 var discard=first!=0;var row:usize=0;var col:usize=0;var pending=false;
 var at=first;while at<count{
  let byte=*(ring+(at&4095) as usize);at+=1;
  if discard{if byte==10{discard=false;}continue;}
  if byte==13{continue;}
  if byte==10{if col!=0{pending=true;}continue;}
  if pending||col==40{
   if row==7{var i:usize=0;while i<7{STATE.text[i]=STATE.text[i+1];i+=1;}STATE.text[7]=[0;41];}
   else{row+=1;}col=0;pending=false;
  }
  var value=byte;if value>=97&&value<=122{value-=32;}
  if value<32||value>95{value=63;}
  STATE.text[row][col]=value;col+=1;
 }
}return;}
// Match only complete, exact log records. An incomplete or clipped line must
// never become evidence. Zero-valued error records are not failures.
unsafe fn prefix(ring:*const u8,start:u64,bytes:u64,key:[]const u8)bool{unsafe{
 if bytes<key.len as u64{return false;}var i:usize=0;
 while i<key.len{if *(ring+((start+i as u64)&4095) as usize)!=key[i]{return false;}i+=1;}
 return true;
}}
unsafe fn error_line(ring:*const u8,start:u64,bytes:u64,key:[]const u8)bool{unsafe{
 if bytes!=key.len as u64+16||!prefix(ring,start,bytes,key){return false;}
 var value:u64=0;var i:u64=0;while i<16{
  let c=*(ring+((start+key.len as u64+i)&4095) as usize);var digit:u64=0;
  if c>=48&&c<=57{digit=(c-48) as u64;}else if c>=97&&c<=102{digit=(c-87) as u64;}else{return false;}
  value=(value<<4)|digit;i+=1;
 }return value!=0;
}}
unsafe fn issue(ring:*const u8,start:u64,bytes:u64)u64{unsafe{
 if error_line(ring,start,bytes,"usb_probe_error=0x"){return 1;}
 if error_line(ring,start,bytes,"usb_rejected_error=0x"){return 2;}
 if error_line(ring,start,bytes,"usb_bot_error=0x"){return 3;}
 if error_line(ring,start,bytes,"xhci_error=0x"){return 4;}
 if error_line(ring,start,bytes,"usb_hid_error=0x"){return 5;}
 if error_line(ring,start,bytes,"usb_proxy_error=0x"){return 6;}
 if error_line(ring,start,bytes,"usb_proxy_recovery_error=0x"){return 7;}
 if bytes==24&&prefix(ring,start,bytes,"DONGOS_XHCI_DEVICE_LIMIT"){return 8;}
 return 0;
}}
unsafe fn detail(ring:*const u8,start:u64,bytes:u64,kind:u64)bool{unsafe{
 if kind==2{return prefix(ring,start,bytes,"usb_rejected_phase=0x")
  ||prefix(ring,start,bytes,"usb_rejected_slot=0x")||prefix(ring,start,bytes,"usb_rejected_held=0x");}
 if kind==3{return prefix(ring,start,bytes,"usb_bot_held=0x");}
 if kind==4{return prefix(ring,start,bytes,"xhci_phase=0x")||prefix(ring,start,bytes,"xhci_held=0x");}
 if kind==5{return prefix(ring,start,bytes,"xhci_held=0x");}return false;
}}
// Keep the earliest USB issue and, separately, the terminal xHCI failure.
// Only its contiguous detail records may extend a snapshot. Later init/revoke
// messages and ring wrap cannot replace either record. This never stops boot.
unsafe fn failures(ring:*const u8,count:u64)void{unsafe{
 var start:u64=0;var discard=false;if count>4096{start=count-4096;discard=true;}
 var at=start;while at<count{
  let byte=*(ring+(at&4095) as usize);at+=1;if byte!=10{continue;}
  if discard{discard=false;start=at;continue;}
  if at>STATE.accepted{
   var bytes=at-start-1;if bytes!=0&&*(ring+((at-2)&4095) as usize)==13{bytes-=1;}
   let kind=issue(ring,start,bytes);
   if FIRST_KIND==0&&kind!=0{lines(ring,at,count);STATE.first=STATE.text;FIRST_KIND=kind;STATE.fault=1;}
   else if FIRST_KIND!=0&&!FIRST_CLOSED{
    if detail(ring,start,bytes,FIRST_KIND){lines(ring,at,count);STATE.first=STATE.text;}else{FIRST_CLOSED=true;}
   }
   if TERMINAL_KIND==0&&kind>=4&&kind<=6{lines(ring,at,count);TERMINAL_KIND=kind;}
   else if TERMINAL_KIND!=0&&!TERMINAL_CLOSED{
    if detail(ring,start,bytes,TERMINAL_KIND){lines(ring,at,count);}else{TERMINAL_CLOSED=true;}
   }
  }start=at;
 }
}return;}
// kind1: before commit (kernel root/xstate), kind2: after log acceptance,
// kind3: after complete_entry and kernel xstate restore, BEFORE the deadline.
pub export("dong_startup_console_run") fn run(kind:u64,head:u64,count:u64,ring:*const u8)u64{unsafe{
 if STATE.stopped!=0{return 0;}
 if kind<1||kind>3||head>=4096||head!=(count&4095)||(count!=0&&ring==null){return 0;}
 let info=ub.report();let b=bridge.pointer();
 if info==null||b==null||(*info).ready!=1||(*info).count<3||(*info).count>16||(*info).headers==0||(*info).domain==0{return 0;}
 let d=(*info).domain as *const ud.Domain;
 if (*d).cpus==null||(*d).processes==null||(*b).domain!=d as *ud.Domain||(*b).headers!=(*info).headers as *u64{return 0;}
 let c=(*d).cpus;let address=*(((*info).headers as *const u64));if address==0{return 0;}
 let h=address as *const ep.Cpu;
 if (*h).ready!=2||(*h).logical_id!=0||(*h).domain!=(*info).domain||(*h).kernel_xstate==0
  ||((*h).kernel_xstate&63)!=0||(*h).kernel_xstate>0xffff_ffff_ffff_ffff-1024-sizeof(ep.Metrics) as u64{return 0;}
 // cfg3 has a permanently reserved slot and BSP-only affinity. Disable before
 // its very first IRET, even if it never marks ready or later fails/restarts.
 let handoff=kind==1&&(*c).slot==3&&(*c).mode==6;
 if kind==1{STATE.returns+=1;}else if kind==3{STATE.captures+=1;}else{STATE.logs+=1;}
 let paint=handoff||(kind==1&&STATE.returns<=2)||(kind==3&&STATE.captures<=2)||(kind==2&&count!=STATE.accepted);
 if !paint{return 0;}
 STATE.done=0;STATE.version=1;STATE.kind=kind;STATE.slot=(*c).slot;STATE.syscalls=(*h).syscalls;STATE.event=(*h).event;
 let metrics=((*h).kernel_xstate+1024) as *const ep.Metrics;STATE.entries=(*metrics).user_entries;
 STATE.bridge_stage=bridge.PROGRESS[0].stage;STATE.operation=0;STATE.rip=0;
 if (*c).slot<16&&(*c).token!=0{
  var frame:u64=(*c).returned;if kind==3{frame=(*c).capture;}
  if frame!=0{let f=frame as *const abi.Frame;STATE.operation=(*f).rax;STATE.rip=(*f).rip;}
 }
 if count!=0{failures(ring,count);if TERMINAL_KIND==0{lines(ring,count,count);}}else{STATE.text=[[0;41];8];}STATE.accepted=count;
 if handoff{STATE.kind=4;STATE.stopped=1;}
 compiler_fence();STATE.done=1;return 1;
}}
