// Failure-only status. Normal user execution never calls this producer.
module boot.user_runtime_status;
import sched.user_boot as ub;
import sched.user_domain as ud;
import sched.user_bridge as bridge;
import sched.user_entry_plan as ep;
import user.abi as abi;
pub const INVALID:u64=0x0b06_0001;
pub struct Report{pub version:u64,pub done:u64,pub error_code:u64,pub cpu:u64,pub cpus:u64,
 pub failure_cpu:u64,pub failure_code:u64,pub failure_detail:u64,pub entry:u64,pub event:u64,pub stage:u64,
 pub domain_failed:u64,pub bridge_failed:u64,pub lock:u64,pub owner:u64,pub online:u64,
 pub mode:u64,pub slot:u64,pub token:u64,pub captured:u64,pub syscalls:u64,pub user_entries:u64,pub header_error:u64,
 pub operation:u64,pub rip:u64,pub rsp:u64,pub frame_root:u64,pub raw_root:u64,pub pcid:u64,pub calls:u64,
 pub failure_mask:u64,pub frame_kind:u64}
const EMPTY:Report=Report{version:0,done:0,error_code:0,cpu:0,cpus:0,failure_cpu:0,failure_code:0,failure_detail:0,
 entry:0,event:0,stage:0,domain_failed:0,bridge_failed:0,lock:0,owner:0,online:0,mode:0,slot:0,token:0,captured:0,
 syscalls:0,user_entries:0,header_error:0,operation:0,rip:0,rsp:0,frame_root:0,raw_root:0,pcid:0,calls:0,failure_mask:0,frame_kind:0};
var STATE:Report=EMPTY;
pub export("dong_user_runtime_status_pointer") fn pointer()*const Report{unsafe{return &STATE;}}
pub export("dong_user_runtime_status_run") fn run(cpu:usize,raw_root:u64)*const Report{unsafe{
 if STATE.version!=0{return &STATE;}
 STATE.version=1;STATE.cpu=cpu as u64;STATE.raw_root=raw_root;STATE.slot=16;STATE.failure_cpu=16;
 let info=ub.report();let b=bridge.pointer();
 if cpu!=0||info==null||b==null{STATE.error_code=INVALID;STATE.done=1;return &STATE;}
 STATE.cpus=(*info).count;
 if STATE.cpus<3||STATE.cpus>16||(*info).domain==0||(*info).headers==0{STATE.error_code=INVALID;STATE.done=1;return &STATE;}
 let d=(*info).domain as *const ud.Domain;
 if (*d).cpus==null||(*d).processes==null||(*b).domain!=d as *ud.Domain||(*b).headers!=(*info).headers as *u64{
  STATE.error_code=INVALID;STATE.done=1;return &STATE;
 }
 let c=(*d).cpus;let address=*(((*info).headers as *const u64));
 if address==0{STATE.error_code=INVALID;STATE.done=1;return &STATE;}
 let h=address as *const ep.Cpu;
 if (*h).ready!=2||(*h).logical_id!=0||(*h).domain!=(*info).domain||(*h).kernel_xstate==0
  ||((*h).kernel_xstate&63)!=0||(*h).kernel_xstate>0xffff_ffff_ffff_ffff-1024-sizeof(ep.Metrics) as u64{
  STATE.error_code=INVALID;STATE.done=1;return &STATE;
 }
 STATE.domain_failed=atomic_load(&(*d).failed);STATE.bridge_failed=(*b).failed;STATE.lock=atomic_load(&(*d).lock);
 STATE.owner=(*d).owner;STATE.online=(*d).online;STATE.mode=(*c).mode;STATE.slot=(*c).slot;STATE.token=(*c).token;
 STATE.captured=(*c).captured;STATE.syscalls=(*h).syscalls;STATE.header_error=(*h).last_error;STATE.pcid=(*h).pcid_enabled;
 STATE.calls=(*b).calls;STATE.event=(*h).event;STATE.entry=bridge.PROGRESS[0].entry;STATE.stage=bridge.PROGRESS[0].stage;
 let metrics=((*h).kernel_xstate+1024) as *const ep.Metrics;STATE.user_entries=(*metrics).user_entries;
 STATE.failure_code=STATE.header_error;
 var id:usize=0;while id<STATE.cpus as usize{
  let f=&bridge.FAILURES[id];if atomic_load(&(*f).published)==1{
   STATE.failure_mask|=1<<id as u64;
   if STATE.failure_cpu==16{
    STATE.failure_cpu=id as u64;STATE.failure_code=(*f).error_code;STATE.failure_detail=(*f).detail_code;
    STATE.entry=(*f).entry;STATE.event=(*f).vector;STATE.stage=(*f).stage;
   }
  }id+=1;
 }
 // Permanent selected-return storage, not a raw exception frame or live RIP.
 if STATE.token!=0&&STATE.slot<16&&(*c).returned!=0&&(*c).return_root!=0{
  let f=(*c).returned as *const abi.Frame;STATE.operation=(*f).rax;STATE.rip=(*f).rip;STATE.rsp=(*f).rsp;
  STATE.frame_root=(*f).cr3;STATE.frame_kind=2;
 }
 compiler_fence();STATE.done=1;return &STATE;
}}
